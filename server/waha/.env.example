WAHA_API_KEY=ganti-dengan-string-acak-panjang
WAHA_DASH_USER=admin
WAHA_DASH_PASS=ganti-password-dashboard
WAHA_ENGINE=NOWEB
WAHA_TAG=latest
# Media WhatsApp: false = tidak diunduh (hemat disk & CPU; bot hanya membaca teks)
#                 true  = diunduh, jenis file (gambar/video/dokumen) terbaca di dashboard
WAHA_DOWNLOAD_MEDIA=true
# Lama file media disimpan (detik). 180 = 3 menit; 0 = selamanya (awas disk penuh)
WAHA_FILES_LIFETIME=180
